# Nalu — variables d'environnement
#
# Les deux variables sont OPTIONNELLES. Sans elles, le projet demarre, les tests
# passent et le dashboard s'affiche depuis le cache parquet versionne. C'est la
# promesse centrale : la demo tourne sans reseau et sans cle.
#
# Copier en `.env` (ignore par git) pour un remplissage a chaud.

# Token affilie Travelpayouts, utilise par l'ingestion des prix de vols.
# Absent : le dashboard affiche les spots sans axe prix, marques comme non couverts.
TRAVELPAYOUTS_TOKEN=

# Cle Google AI Studio (Gemini), utilisee par le commentaire automatique des resultats.
# Absente : le bloc commentaire affiche un message explicite, le reste fonctionne.
GEMINI_API_KEY=
